		local previousGui = previousPlayer and previousPlayer:FindFirstChild("PlayerGui")

		if previousGui then
			local statsGui = previousGui:FindFirstChild("EggHatchStats")

			if statsGui then
				statsGui:Destroy()
			end

			local playerBlackScreen = previousGui:FindFirstChild("BGSI_BlackScreen")

			if playerBlackScreen then
