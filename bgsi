			if type(v) == "boolean" then
				pcall(function()
					oldV14[k] = false
				end)
			end
		end
	end

	-- Destroy the Fluent UI window and screen gui
	if type(oldLib) == "table" then
		if type(oldLib.Destroy) == "function" then
			pcall(oldLib.Destroy, oldLib)
		end

		for _, child in ipairs(oldLib or {}) do
			if type(child) == "table" and type(child.Destroy) == "function" then
				pcall(child.Destroy, child)
			end
		end
