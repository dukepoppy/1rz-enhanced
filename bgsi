	local oldUI = rawget(genv2, "BGSI_HubUI")

	if typeof(oldUI) == "Instance" then
		pcall(function()
			oldUI:Destroy()
		end)
	end

	rawset(genv2, "BGSI_HubUI", nil)

	pcall(function()
		local coreGui = game:GetService("CoreGui")

		for _, gui in ipairs(coreGui:GetChildren()) do
			if gui:IsA("ScreenGui") then
				local tagged = gui:GetAttribute("BGSI_HubUI") == true
				local frameCount = 0

				if not tagged and gui.Name == "ScreenGui" then
					for _, child in ipairs(gui:GetChildren()) do
						if child:IsA("Frame") then
							frameCount += 1
						end
					end
				end

				-- The hub's Fluent window: 30+ top-level frames (one per tab
				-- container). Anything smaller is left alone.
				if tagged or frameCount >= 30 then
