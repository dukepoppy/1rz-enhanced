			end
		end

		local lighting = game:GetService("Lighting")
		local backup = genv2.BGSI_LightingBackup

		if type(backup) == "table" then
			for k, value in pairs(backup) do
				pcall(function()
					lighting[k] = value
				end)
			end

			genv2.BGSI_LightingBackup = nil
		end

		pcall(function()
			game:GetService("RunService"):Set3dRenderingEnabled(true)
		end)

		local blackScreen = game:GetService("CoreGui"):FindFirstChild("BGSI_BlackScreen")

		if blackScreen then
			blackScreen:Destroy()
		end
	end)

	warn("[1rzHub] Unloaded previous instance")
end

